# ==============================================================================
# BETWEEN US — PUBLIC ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# WARNING: NEVER place production secrets, private keys, or API tokens in this file
# or in any file prefixed with NEXT_PUBLIC_*.
# ==============================================================================

# Public Signaling Server Endpoint (WSS)
NEXT_PUBLIC_SIGNALING_SERVER_URL=wss://signaling.betweenus.app

# Public STUN Server Configuration
NEXT_PUBLIC_STUN_SERVER_URL=stun:turn.betweenus.app:3478

# Application Environment Mode
NEXT_PUBLIC_APP_ENV=development

# ==============================================================================
# SERVER-ONLY CONFIDENTIAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# SECURITY INVARIANT: The variables below MUST NEVER be prefixed with NEXT_PUBLIC_
# and MUST NEVER be committed to Git or exposed to client-side bundles.
# ==============================================================================

# Server-side Coturn Shared Secret (used for short-lived REST credentials HMAC-SHA1)
TURN_SHARED_SECRET=example_server_side_shared_secret_never_commit_real_value

# Coturn Relay Hostname / FQDN
TURN_HOST=turn.betweenus.app

# Coturn Exposed STUN/TURN Ports
TURN_PORT=3478
TURN_TLS_PORT=5349

# Credential Time-To-Live (seconds)
TURN_CREDENTIAL_TTL_SEC=600

