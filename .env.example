# ==============================================================================
# BETWEEN US — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development and fill in your values.
# NEVER commit .env.local or place server-only secrets in NEXT_PUBLIC_* variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC CLIENT-SAFE VARIABLES (Exposed to Browser Bundle)
# ------------------------------------------------------------------------------

# Supabase Project URL and Public Anon Key (Required for Pairing & Realtime Signaling)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_placeholder

# Public STUN Server URL (Optional — falls back to public STUN list in lib/webrtc/ice.ts)
NEXT_PUBLIC_STUN_SERVER_URL=stun:stun.l.google.com:19302

# Optional Custom WebSocket Signaling URL (Used only by the optional self-hosted WS signaling server)
NEXT_PUBLIC_SIGNALING_SERVER_URL=wss://signaling.example.com

# Optional Custom TURN Relay URL (Optional — prefer server-issued ephemeral credentials via /api/turn/credentials)
# NEXT_PUBLIC_TURN_SERVER_URL=turn:turn.example.com:3478

# Web Push VAPID Public Key (Optional — required for persistent Web Push notifications across restarts)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_placeholder

# Application Environment Mode (development | production)
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# SERVER-ONLY CONFIDENTIAL VARIABLES (NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Server-side Coturn HMAC Shared Secret for short-lived REST credentials (/api/turn/credentials)
TURN_SHARED_SECRET=replace_with_high_entropy_server_secret

# Coturn Relay Hostname / FQDN and Ports
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_CREDENTIAL_TTL_SEC=600

# Web Push VAPID Private Key & Contact Subject (Server-only — never expose to browser)
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:security@example.com

# Optional Self-Hosted WebSocket Signaling Server Port (server/signaling/config.ts)
SIGNALING_PORT=8080
